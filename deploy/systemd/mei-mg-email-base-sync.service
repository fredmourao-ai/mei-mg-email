[Unit]
Description=MEI MG daily CNPJ base synchronization
After=network-online.target
Wants=network-online.target

[Service]
ExecStartPre=/usr/bin/python3 /home/ubuntu/mei-mg-email/scripts/runtime_policy_guard.py
Type=oneshot
User=__RUN_USER__
WorkingDirectory=__APP_DIR__
ExecStart=__PYTHON__ scripts/sincronizar_base_diaria.py
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
