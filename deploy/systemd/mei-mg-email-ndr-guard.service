[Unit]
Description=MEI MG asynchronous Exchange NDR sender-block guard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__APP_DIR__
ExecStart=__PYTHON__ scripts/ndr_guard_v2.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=SENDER_BLOCK_SENTINEL_PATH=/var/lib/mei-mg-email/sender_blocked.pause
Environment=NDR_GUARD_STATE_PATH=/var/lib/mei-mg-email/ndr_guard_state.json
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
