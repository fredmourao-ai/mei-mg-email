[Unit]
Description=MEI email rapid verification and auto-repair
After=network-online.target docker.service mei-mg-email-worker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/ubuntu/mei-mg-email
EnvironmentFile=-/home/ubuntu/mei-mg-email/.env
ExecStart=/home/ubuntu/mei-mg-email/.venv/bin/python /home/ubuntu/mei-mg-email/scripts/autocorrigir_envios_guarded.py
TimeoutStartSec=10min
Nice=5
# If the repair itself hangs, systemd kills it; the guarded wrapper restores
# the worker unless a real sender-block sentinel is present.
KillMode=mixed
