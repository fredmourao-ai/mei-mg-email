[Unit]
Description=MEI email 15-minute nonstop availability supervisor
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/ubuntu/mei-mg-email
EnvironmentFile=-/home/ubuntu/mei-mg-email/.env
ExecStart=/home/ubuntu/mei-mg-email/.venv/bin/python /home/ubuntu/mei-mg-email/scripts/nonstop_supervisor_15m.py
TimeoutStartSec=90
Nice=5
# Never quiesce a healthy worker for routine verification. The only global
# stop condition handled here is a current Microsoft sender-block sentinel.
KillMode=mixed
