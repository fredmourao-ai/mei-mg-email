[Unit]
Description=MEI email 15-minute nonstop availability supervisor
After=network-online.target docker.service
Wants=network-online.target

[Service]
ExecStartPre=__PYTHON__ __APP_DIR__/scripts/runtime_policy_guard.py
Type=oneshot
User=root
WorkingDirectory=__APP_DIR__
EnvironmentFile=-__APP_DIR__/.env
ExecStart=__PYTHON__ __APP_DIR__/scripts/nonstop_supervisor_15m.py
TimeoutStartSec=90
Nice=5
# Never quiesce a healthy worker for routine verification. The only global
# stop condition handled here is a current Microsoft sender-block sentinel.
KillMode=mixed
