[Unit]
Description=MEI MG Email Microsoft Graph App-Only Worker
After=network-online.target
Wants=network-online.target
# Non-stop policy: the sender worker must not remain stopped unless the
# application creates the current Microsoft/sender-block sentinel. Disable
# systemd start-rate limiting so repeated transient recipient/network failures
# cannot leave the unit permanently inactive without that sentinel.
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/mei-mg-email
EnvironmentFile=-/home/ubuntu/mei-mg-email/.env
# ExecStartPre is intentionally bounded. Bulk queue cleanup belongs to the
# autorepair path and must never strand the nonstop worker in activating state.
ExecStartPre=/home/ubuntu/mei-mg-email/.venv/bin/python /home/ubuntu/mei-mg-email/scripts/runtime_sender_preflight.py
# The safe entrypoint rechecks independent consent, verified-MEI source,
# suppressions and terminal-send history immediately before every Graph call.
ExecStart=/home/ubuntu/mei-mg-email/.venv/bin/python -m worker.safe_entrypoint
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=45
KillSignal=SIGTERM
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
