[Unit]
Description=MEI MG Email Brevo Free Worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=-__APP_DIR__/.env
ExecStartPre=__PYTHON__ __APP_DIR__/scripts/runtime_policy_guard.py
ExecStartPre=__PYTHON__ __APP_DIR__/scripts/runtime_sender_preflight.py
ExecStart=__PYTHON__ -m worker.safe_entrypoint_v2
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=45
KillSignal=SIGTERM
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
