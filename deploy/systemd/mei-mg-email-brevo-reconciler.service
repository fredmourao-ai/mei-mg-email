[Unit]
Description=MEI MG Email Brevo delivery event reconciler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=-__APP_DIR__/.env
Environment=PYTHONUNBUFFERED=1
Environment=BREVO_EVENT_STATE_PATH=/var/lib/mei-mg-email/brevo_event_state.json
ExecStartPre=__PYTHON__ __APP_DIR__/scripts/runtime_policy_guard.py
ExecStart=__PYTHON__ scripts/brevo_event_reconciler.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
