[Unit]
Description=MEI MG Email canonical queue replenisher
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=-__APP_DIR__/.env
ExecStartPre=__PYTHON__ __APP_DIR__/scripts/runtime_policy_guard.py
ExecStart=__PYTHON__ __APP_DIR__/scripts/queue_replenisher.py
Restart=always
RestartSec=5
TimeoutStartSec=30
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
