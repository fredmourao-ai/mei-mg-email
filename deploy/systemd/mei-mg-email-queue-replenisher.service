[Unit]
Description=MEI MG Email canonical queue replenisher
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/mei-mg-email
EnvironmentFile=-/home/ubuntu/mei-mg-email/.env
ExecStartPre=/home/ubuntu/mei-mg-email/.venv/bin/python /home/ubuntu/mei-mg-email/scripts/runtime_policy_guard.py
ExecStart=/home/ubuntu/mei-mg-email/.venv/bin/python /home/ubuntu/mei-mg-email/scripts/queue_replenisher.py
Restart=always
RestartSec=5
TimeoutStartSec=30
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
