# RETIRED_SOURCE_TUNNEL_GUARD_20261029
# The deleted site's reverse tunnel must not be started by systemd, installer
# or a service restart. Provision a separately approved transport under a new
# unit after endpoint, host key, RBAC and rollback validation.
[Unit]
Description=RETIRED MEI-to-Site reverse tunnel (disabled by design)
RefuseManualStart=yes

[Service]
Type=oneshot
ExecStart=/usr/bin/false
Restart=no
NoNewPrivileges=true
