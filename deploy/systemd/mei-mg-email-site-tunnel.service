# RETIRED_SOURCE_TUNNEL_GUARD_20261029
# This base unit intentionally has NO SSH destination or copied secret.
# An independently authorized, root-owned drop-in 50-marina.conf must
# supply the effective ExecStart for the live private Marina relay.
[Unit]
Description=MEI MG Email verified private reverse tunnel to ShopVivaliz Marina
After=network-online.target mei-mg-email-api.service
Wants=network-online.target
Requires=mei-mg-email-api.service
PartOf=mei-mg-email-api.service
ConditionPathExists=/etc/systemd/system/mei-mg-email-site-tunnel.service.d/50-marina.conf

[Service]
Type=simple
User=__RUN_USER__
ExecStart=/usr/bin/false
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
