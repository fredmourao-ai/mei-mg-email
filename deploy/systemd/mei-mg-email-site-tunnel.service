[Unit]
Description=MEI MG Email private reverse tunnel to ShopVivaliz site
After=network-online.target mei-mg-email-api.service
Wants=network-online.target
Requires=mei-mg-email-api.service
PartOf=mei-mg-email-api.service

[Service]
Type=simple
User=__RUN_USER__
ExecStart=/usr/bin/ssh -NT -i /home/ubuntu/.ssh/shopvivaliz-free-a1-monitor -o BatchMode=yes -o IdentitiesOnly=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=yes -R 127.0.0.1:18010:127.0.0.1:8010 ubuntu@10.0.1.112
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
