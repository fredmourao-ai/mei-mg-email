# Postgres local
POSTGRES_PASSWORD=postgres_local_dev_change_me
DATABASE_URL=postgresql://postgres:postgres_local_dev_change_me@localhost:5433/mei_mg_email

# API
API_HOST=0.0.0.0
API_PORT=8000

# Worker / disparo
# Teto tecnico: 10.000 destinatarios em janela movel de 24h.
MAX_ENVIOS_POR_DIA=10000
META_ENVIOS_POR_DIA=9950
RATE_LIMIT_ENVIOS_POR_MINUTO=30
# Cap efetivo de recuperacao de reputacao; o worker usa o menor valor.
DELIVERABILITY_MAX_ENVIOS_POR_MINUTO=10
WORKER_POLL_INTERVAL_SEGUNDOS=5

# Politica operacional 2026-08-13:
# V022 marca o estoque existente marketing_autorizado=true e mei_verificado=true.
# V023 aplica os mesmos flags a novos INSERTs, com origem auditavel do operador.
# opt_out continua soberano e impede envio.

# Fila continua
QUEUE_MIN_PENDING=1000
QUEUE_TARGET_PENDING=5000

# Estado persistente do circuit breaker. Em producao, o instalador cria um link
# de runtime/sender_blocked.pause para este caminho fora do Git.
SENDER_BLOCK_SENTINEL_PATH=/var/lib/mei-mg-email/sender_blocked.pause

# NDR guard assincrono. Requer Microsoft Graph application permission Mail.Read
# para a caixa configurada em MICROSOFT_GRAPH_USER.
NDR_GUARD_POLL_SECONDS=60
NDR_GUARD_LOOKBACK_MINUTES=20
NDR_GUARD_MAX_MESSAGES=50
NDR_GUARD_STATE_PATH=/var/lib/mei-mg-email/ndr_guard_state.json

# Monitor residente da VM
MONITOR_INTERVAL_SECONDS=60
MONITOR_SEND_STALL_MINUTES=10
MONITOR_BASE_MAX_AGE_HOURS=26
MONITOR_STATUS_DIR=runtime/monitor
MONITOR_WORKER_UNIT=mei-mg-email-worker.service
MONITOR_BASE_TIMER_UNIT=mei-mg-email-base-sync.timer

# Sincronizacao automatica da base
CNPJ_DAILY_SOURCE=casadosdados
CNPJ_DAILY_TIMEZONE=America/Sao_Paulo
CNPJ_BASE_MAX_SOURCE_AGE_HOURS=48
CASA_DOS_DADOS_API_KEY=

# Microsoft 365
MICROSOFT_SENDER_DOMAIN=dev.shopvivaliz.com.br
MAIL_FROM=Contabilidade Melo <naoresponda@dev.shopvivaliz.com.br>
MAIL_FROM_NAME=Contabilidade Melo
BASE_URL_DESCADASTRO=https://dev.shopvivaliz.com.br/descadastro

# Microsoft Graph app-only X.509
EMAIL_PROVIDER=microsoft_graph
MICROSOFT_GRAPH_AUTH_MODE=app_only_cert
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_USER=naoresponda@dev.shopvivaliz.com.br
MICROSOFT_GRAPH_CERT_PATH=/home/ubuntu/.shopvivaliz/m365/graph-auth.crt
MICROSOFT_GRAPH_KEY_PATH=/home/ubuntu/.shopvivaliz/m365/graph-auth.key

# Nunca armazene chave privada, senha ou token no Git.

# TERRL: preencha somente com valor confirmado no Exchange Admin Center.
MICROSOFT_TERRL_THRESHOLD=
