# Postgres local
POSTGRES_PASSWORD=postgres_local_dev_change_me
DATABASE_URL=postgresql://postgres:postgres_local_dev_change_me@localhost:5433/mei_mg_email

# API
API_HOST=0.0.0.0
API_PORT=8000

# Worker / disparo
# NAO mude pra 'gmail' sem ter certeza -- isso liga envio de e-mail de
# verdade (worker/worker.py so entra em modo de envio real quando isso
# muda). dryrun continua sendo o padrao proposital.
EMAIL_PROVIDER=dryrun          # dryrun | gmail
RATE_LIMIT_ENVIOS_POR_MINUTO=60
WORKER_POLL_INTERVAL_SEGUNDOS=5

# So usado se EMAIL_PROVIDER=gmail. GMAIL_APP_PASSWORD e uma "App Password"
# (myaccount.google.com/apppasswords, exige 2FA na conta) -- NUNCA a senha
# normal do Gmail. Gerar manualmente, nunca commitar.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Usado no link de descadastro nos templates ({{unsubscribe_url}})
BASE_URL_DESCADASTRO=http://localhost:8000/descadastro
