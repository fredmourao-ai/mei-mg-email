# Postgres local
POSTGRES_PASSWORD=postgres_local_dev_change_me
DATABASE_URL=postgresql://postgres:postgres_local_dev_change_me@localhost:5433/mei_mg_email

# API
API_HOST=0.0.0.0
API_PORT=8000

# Worker / disparo
# NAO mude para provedor real sem ter certeza: isso liga envio de e-mail de verdade.
EMAIL_PROVIDER=dryrun          # dryrun | gmail | microsoft
RATE_LIMIT_ENVIOS_POR_MINUTO=30
WORKER_POLL_INTERVAL_SEGUNDOS=5

# Microsoft / Outlook / Office 365 SMTP
# Para Microsoft 365/Exchange Online, use smtp.office365.com:587.
# Para Outlook.com, a Microsoft tambem documenta smtp-mail.outlook.com:587.
# Nunca commitar senha real no Git.
MICROSOFT_SMTP_HOST=smtp.office365.com
MICROSOFT_SMTP_PORT=587
MICROSOFT_SMTP_USER=noreply@ContabilidadeMelo.onmicrosoft.com
MICROSOFT_SMTP_PASS=
MAIL_FROM=Contabilidade Melo <noreply@ContabilidadeMelo.onmicrosoft.com>

# Gmail SMTP, se optar por Gmail no futuro
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Usado no link de descadastro nos templates ({{unsubscribe_url}})
BASE_URL_DESCADASTRO=http://localhost:8000/descadastro
