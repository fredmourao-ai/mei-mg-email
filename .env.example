# Postgres local
POSTGRES_PASSWORD=postgres_local_dev_change_me
DATABASE_URL=postgresql://postgres:postgres_local_dev_change_me@localhost:5433/mei_mg_email

# API
API_HOST=0.0.0.0
API_PORT=8000

# Worker / disparo
# Teto tecnico por caixa do Exchange Online: 10.000 destinatarios em janela
# movel de 24h. O limite de mensagens e 30/min; usamos 20/min para margem.
MAX_ENVIOS_POR_DIA=10000
RATE_LIMIT_ENVIOS_POR_MINUTO=20
WORKER_POLL_INTERVAL_SEGUNDOS=5

# Dominio Microsoft 365 autenticado para o remetente de volume.
# O script scripts/auditar_dns_microsoft.py valida SPF/MX/DKIM/DMARC via
# Cloudflare 1.1.1.1 DoH. O worker nao deve usar *.onmicrosoft.com para volume.
MICROSOFT_SENDER_DOMAIN=dev.shopvivaliz.com.br

# Microsoft / Exchange Online SMTP (fallback; o fluxo principal usa Graph).
MICROSOFT_SMTP_HOST=smtp.office365.com
MICROSOFT_SMTP_PORT=587
MICROSOFT_SMTP_USER=naoresponda@dev.shopvivaliz.com.br
MICROSOFT_SMTP_PASS=
MAIL_FROM=Contabilidade Melo <naoresponda@dev.shopvivaliz.com.br>

# Gmail SMTP, se optar por Gmail no futuro
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Link publico de descadastro usado em toda campanha.
BASE_URL_DESCADASTRO=https://dev.shopvivaliz.com.br/descadastro

# Microsoft Graph (provedor recomendado no projeto atual)
EMAIL_PROVIDER=microsoft_graph
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_USER=naoresponda@dev.shopvivaliz.com.br
MICROSOFT_GRAPH_TOKEN_CACHE=

# TERRL (Tenant External Recipient Rate Limit) e separado do limite por caixa.
# Preencha com o valor exibido em Exchange Admin Center > Reports > Mail flow >
# Tenant Outbound External Recipients. A auditoria fail-closed exige >=10000.
MICROSOFT_TERRL_THRESHOLD=
