# Postgres local
POSTGRES_PASSWORD=postgres_local_dev_change_me
DATABASE_URL=postgresql://postgres:postgres_local_dev_change_me@localhost:5433/mei_mg_email

# API
API_HOST=0.0.0.0
API_PORT=8000

# Worker / disparo
# Capacidade configurada para ate 10.000 destinatarios em janela movel de 24h.
# O Exchange Online tem limite de servico de 10.000 destinatarios/24h e
# 30 mensagens/min. Mantemos 20/min por padrao para reduzir throttling.
MAX_ENVIOS_POR_DIA=10000
RATE_LIMIT_ENVIOS_POR_MINUTO=20
WORKER_POLL_INTERVAL_SEGUNDOS=5

# Microsoft / Exchange Online SMTP
# Use smtp.office365.com:587 para Microsoft 365/Exchange Online.
# IMPORTANTE: nao use dominio *.onmicrosoft.com para disparo externo em volume.
# A Microsoft limita o dominio onmicrosoft padrao a 100 destinatarios externos
# por organizacao em 24h. Para a operacao de 10.000/dia, use uma caixa dedicada
# em dominio proprio validado no tenant, por exemplo envios@seudominio.com.br.
# Nunca commitar senha real no Git.
MICROSOFT_SMTP_HOST=smtp.office365.com
MICROSOFT_SMTP_PORT=587
MICROSOFT_SMTP_USER=envios@seudominio.com.br
MICROSOFT_SMTP_PASS=
MAIL_FROM=Contabilidade Melo <envios@seudominio.com.br>

# Gmail SMTP, se optar por Gmail no futuro
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Usado no link de descadastro nos templates ({{unsubscribe_url}})
BASE_URL_DESCADASTRO=https://seudominio.com.br/descadastro

# Microsoft Graph (recomendado no projeto atual)
EMAIL_PROVIDER=microsoft_graph
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_USER=envios@seudominio.com.br
MICROSOFT_GRAPH_TOKEN_CACHE=
