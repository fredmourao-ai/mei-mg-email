# Postgres local
POSTGRES_PASSWORD=postgres_local_dev_change_me
DATABASE_URL=postgresql://postgres:postgres_local_dev_change_me@localhost:5433/mei_mg_email

# API
API_HOST=0.0.0.0
API_PORT=8000

# Brevo Free / worker
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
MAIL_FROM=Contabilidade Melo <atendimento@shopvivaliz.com.br>
MAIL_FROM_NAME=Contabilidade Melo
BASE_URL_DESCADASTRO=https://dev.shopvivaliz.com.br/descadastro

# Teto absoluto do plano Free e meta com margem operacional.
MAX_ENVIOS_POR_DIA=300
META_ENVIOS_POR_DIA=295
RATE_LIMIT_ENVIOS_POR_MINUTO=10
DELIVERABILITY_MAX_ENVIOS_POR_MINUTO=10
WORKER_POLL_INTERVAL_SEGUNDOS=5

# Politica canonica: ver AGENTS.md. Gates legados aposentados nao podem
# voltar ao fluxo operacional. Opt-out e suppressions tecnicas continuam soberanos.

# Fila continua
QUEUE_MIN_PENDING=14800
QUEUE_TARGET_PENDING=15000

# Pausa operacional persistente fora do Git.
SENDER_BLOCK_SENTINEL_PATH=/var/lib/mei-mg-email/sender_blocked.pause

# Reconciliacao de entrega Brevo. Polling deterministico, sem IA.
BREVO_EVENT_POLL_SECONDS=60
BREVO_EVENT_LOOKBACK_DAYS=2
BREVO_EVENT_LIMIT=500
BREVO_EVENT_MAX_PAGES=10
BREVO_EVENT_TIMEOUT_SECONDS=30
BREVO_EVENT_MAX_SEEN_KEYS=5000
BREVO_EVENT_STATE_PATH=/var/lib/mei-mg-email/brevo_event_state.json

# Teste controlado de entrega real.
TEST_RECIPIENT=atendimento@shopvivaliz.com.br
BREVO_TEST_TIMEOUT_SECONDS=180
BREVO_TEST_POLL_SECONDS=5

# Monitor residente da VM
MONITOR_INTERVAL_SECONDS=60
MONITOR_SEND_STALL_MINUTES=10
MONITOR_BASE_MAX_AGE_HOURS=26
MONITOR_STATUS_DIR=runtime/monitor
MONITOR_WORKER_UNIT=mei-mg-email-worker.service
MONITOR_BREVO_RECONCILER_UNIT=mei-mg-email-brevo-reconciler.service
MONITOR_BASE_TIMER_UNIT=mei-mg-email-base-sync.timer

# Sincronizacao automatica da base
CNPJ_DAILY_SOURCE=casadosdados
CNPJ_DAILY_TIMEZONE=America/Sao_Paulo
CNPJ_BASE_MAX_SOURCE_AGE_HOURS=48
CASA_DOS_DADOS_API_KEY=

# Nunca armazene chave privada, senha ou token no Git.
